# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env/

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Distribution / packaging ─────────────────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ── Type checking ────────────────────────────────────────────────────────────
.mypy_cache/
.dmypy.json

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
*.swp
*.swo

# ── Runtime upload / output / report data ────────────────────────────────────
# Keep the directory structure (via .gitkeep) but ignore all job data
app/uploads/*/
app/outputs/*/
app/reports/*/

# Loose CSV / DXF / DWG files dropped directly in app/
app/*.csv
app/*.dxf
app/*.dwg

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
